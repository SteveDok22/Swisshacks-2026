# === App ===
# NOTE: team-shared keys live in the tracked `.env.shared` (loaded first).
# This .env (gitignored) is for PERSONAL overrides and wins over .env.shared.
ENVIRONMENT=development
DEBUG=true

# === External API master switch ===
# Default (false) = fully OFFLINE: no outbound calls to ANY third party.
#   - Public-intel source adapters are bypassed; the engine uses deterministic
#     synthetic signals (mock data) instead.
#   - The Anthropic client is forced into mock mode regardless of any key below.
# Flip to true ONLY once the keys/credentials below are configured and you want
# live integrations. Everything under here is ignored while this is false.
EXTERNAL_APIS_ENABLED=false

# === LLM ===
# Used only when EXTERNAL_APIS_ENABLED=true. Get your key from
# https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# === Database ===
DATABASE_URL=sqlite+aiosqlite:///./data/risk_platform.db

# === Source adapters ===
# ZEFIX (Swiss commercial register) — free, but the ZefixPublicREST API needs a
# free registered HTTP Basic-auth account. Request one from zefix@bj.admin.ch.
# Leave blank to run without ZEFIX: the adapter degrades gracefully (no fetch).
ZEFIX_USERNAME=
ZEFIX_PASSWORD=

# === External news sources ===
# Optional paid enhancement (EventRegistry / NewsAPI.ai).
# When absent, the adapter returns [] and GDELT (free) is the fallback.
# Get a key at https://newsapi.ai/
EVENT_REGISTRY_API_KEY=

# === Screening sources ===
# OpenSanctions hosted API key. The non-commercial free tier works without a
# key but has tighter rate limits. Get a key at https://www.opensanctions.org/
OPENSANCTIONS_API_KEY=

# === Website content scraping ===
# Firecrawl (live website → markdown) — OPTIONAL. Cloud free tier ~1,000
# pages/month, no card required: https://firecrawl.dev/
# Leave blank to run without a key: FirecrawlAdapter falls back to a plain
# HTTP fetch + HTML-to-text strip (zero cost), so it still yields a current
# website snapshot for the business-model drift comparator.
FIRECRAWL_API_KEY=

# === Domain registration (WHOIS) ===
# whoisjson.com key. RESERVED — the current WhoisAdapter uses keyless RDAP and
# does not consume this yet.
WHOISJSON_API_KEY=

# === Frontend ===
# URL where Next.js runs (for CORS)
CORS_ORIGINS=["http://localhost:3000"]

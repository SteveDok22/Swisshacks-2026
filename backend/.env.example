# === App ===
ENVIRONMENT=development
DEBUG=true

# === LLM ===
# Get your key from https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# === Database ===
DATABASE_URL=sqlite+aiosqlite:///./data/risk_platform.db

# === Source adapters ===
# ZEFIX (Swiss commercial register) — free, but the ZefixPublicREST API needs a
# free registered HTTP Basic-auth account. Request one from zefix@bj.admin.ch.
# Leave blank to run without ZEFIX: the adapter degrades gracefully (no fetch).
ZEFIX_USERNAME=
ZEFIX_PASSWORD=

# === Frontend ===
# URL where Next.js runs (for CORS)
CORS_ORIGINS=["http://localhost:3000"]

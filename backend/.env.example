# === App ===
ENVIRONMENT=development
DEBUG=true

# === LLM ===
# Get your key from https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# === Database ===
DATABASE_URL=sqlite+aiosqlite:///./data/risk_platform.db

# === External news sources ===
# Optional paid enhancement (EventRegistry / NewsAPI.ai).
# When absent, the adapter returns [] and GDELT (free) is the fallback.
# Get a key at https://newsapi.ai/
EVENT_REGISTRY_API_KEY=

# === Frontend ===
# URL where Next.js runs (for CORS)
CORS_ORIGINS=["http://localhost:3000"]
